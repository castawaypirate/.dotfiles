# This repo lives in ~/.dotfiles and its configs are symlinked into ~,
# so paths here are relative to the repo, not to $HOME.

# Backup files
*.backup
*.bak
*.old
*.orig
*~

# Editor swap files
*.swp
*.swo

# Secrets and machine-local settings
.env
.env.*
.bashrc.local

# Logs
*.log

# System files
.DS_Store

# Local docs (not tracked in dotfiles)
docs/
